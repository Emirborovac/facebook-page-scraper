[Unit]
Description=Facebook Page Scraper — FastAPI Service
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=root01
Group=root01
WorkingDirectory=/home/root01/facebook-scraper/facebook-page-scraper
Environment="PATH=/home/root01/facebook-scraper/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
EnvironmentFile=/home/root01/facebook-scraper/facebook-page-scraper/.env
ExecStart=/home/root01/facebook-scraper/venv/bin/uvicorn main:app --host 0.0.0.0 --port 5000 --workers 1 --log-level info
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=fb-scraper

# Allow sufficient time for startup (DB init + worker tasks)
TimeoutStartSec=30
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
